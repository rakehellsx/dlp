[Unit]
Description=Sentinel DLP Center (Drogon / PostgreSQL)
After=network.target postgresql.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=sentinel-dlp
Group=sentinel-dlp
WorkingDirectory=/opt/sentinel-dlp
Environment=TZ=Asia/Shanghai
EnvironmentFile=/etc/dlpcenter.env
ExecStart=/opt/sentinel-dlp/dlpcenter/build/dlpcenter
Restart=on-failure
RestartSec=3
StateDirectory=sentinel-dlp
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/sentinel-dlp

[Install]
WantedBy=multi-user.target
