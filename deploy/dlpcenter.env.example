DLP_DB_HOST=127.0.0.1
DLP_DB_PORT=5432
DLP_DB_NAME=dlpcenter
DLP_DB_USER=dlpcenter
DLP_DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DLP_HTTP_HOST=127.0.0.1
DLP_HTTP_PORT=8091
DLP_CONFIG=/opt/sentinel-dlp/dlpcenter/config.json
DLP_STATIC_ROOT=/opt/sentinel-dlp/static
DLP_IMAGE_HELPER=/opt/sentinel-dlp/dlpcenter/tools/image_processor.py
TZ=Asia/Shanghai
DLP_FILE_ROOT=/var/lib/sentinel-dlp/files

# Optional; Windows example: C:/dlp/.venv/Scripts/python.exe
# DLP_PYTHON=/usr/bin/python3
